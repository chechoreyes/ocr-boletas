# Copia este archivo como ".env" (junto a main2.py) y reemplaza la clave.
# NO subas el archivo .env a git: agrega ".env" a tu .gitignore.

# Clave de build.nvidia.com (empieza con nvapi-)
NVIDIA_API_KEY=nvapi-REEMPLAZA_ESTO

# Opcional: fuerza un modelo. Si no, main2.py elige uno disponible con tu clave.
# NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
